PROJECT_NAME           = "Arcade"
PROJECT_BRIEF          = "Modular arcade launcher with pluggable games and graphics backends"
INPUT                  = src/ README.md docs/
EXCLUDE                = docs/doxygen-awesome
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/INDEX.md
FILE_PATTERNS          = *.cpp *.hpp *.h *.md
EXTENSION_MAPPING      = md=Markdown
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT

HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome/doxygen-awesome.css
HTML_EXTRA_FILES       = docs/doxygen-awesome/doxygen-awesome-darkmode-toggle.js

GENERATE_TREEVIEW      = YES